{
    "name": "Batch Product Descriptions — Step 2: Process Results",
    "flow": [
        {
            "id": 1,
            "module": "util:GetVariable",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "batch_id"
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {},
            "mapper": {
                "ca": "",
                "qs": [],
                "url": "https://api.openai.com/v1/batches/{{1.value}}",
                "gzip": true,
                "method": "GET",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer {{OPENAI_API_KEY}}"
                    }
                ],
                "timeout": "30",
                "useMtls": false,
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "builtin:BasicRouter",
            "version": 1,
            "parameters": {},
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 4,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": {},
                            "filter": {
                                "name": "Batch Completed",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{2.data.status}}",
                                            "b": "completed",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "ca": "",
                                "qs": [],
                                "url": "https://api.openai.com/v1/files/{{2.data.output_file_id}}/content",
                                "gzip": true,
                                "method": "GET",
                                "headers": [
                                    {
                                        "name": "Authorization",
                                        "value": "Bearer {{OPENAI_API_KEY}}"
                                    }
                                ],
                                "timeout": "120",
                                "useMtls": false,
                                "serializeUrl": false,
                                "shareCookies": false,
                                "parseResponse": false,
                                "followRedirect": true,
                                "useQuerystring": false,
                                "followAllRedirects": false,
                                "rejectUnauthorized": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": -150
                                }
                            }
                        },
                        {
                            "id": 5,
                            "module": "util:TextParser",
                            "version": 2,
                            "parameters": {},
                            "mapper": {
                                "text": "{{4.data}}",
                                "pattern": "\\{[^}]+\\}",
                                "global": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1200,
                                    "y": -150
                                }
                            }
                        },
                        {
                            "id": 6,
                            "module": "builtin:BasicIterator",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "array": "{{split(4.data; newline)}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": -150
                                }
                            }
                        },
                        {
                            "id": 7,
                            "module": "json:ParseJSON",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "json": "{{6.value}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1800,
                                    "y": -150
                                }
                            }
                        },
                        {
                            "id": 8,
                            "module": "shopify:UpdateProduct",
                            "version": 2,
                            "parameters": {
                                "__IMTCONN__": 5141758
                            },
                            "mapper": {
                                "product_id": "{{7.custom_id}}",
                                "body_html": "{{if(length(trim(ifempty(7.response.body.choices[1].message.content.ai_body_html; \"\"))) > 100; 7.response.body.choices[1].message.content.ai_body_html; \"\")}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 2100,
                                    "y": -150
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "data": {
                                                "scoped": "true",
                                                "connection": "shopify4"
                                            },
                                            "label": "My Shopify (Custom app) connection"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "util:Noop",
                            "version": 1,
                            "parameters": {},
                            "filter": {
                                "name": "Still Processing",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{2.data.status}}",
                                            "b": "in_progress",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {},
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 150
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "util:Noop",
                            "version": 1,
                            "parameters": {},
                            "filter": {
                                "name": "Failed or Expired",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{2.data.status}}",
                                            "b": "failed",
                                            "o": "text:equal"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{2.data.status}}",
                                            "b": "expired",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {},
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 300
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": [
            {
                "id": 1,
                "text": "## Process Results Scenario\n\n**What it does:**\n1. Gets saved batch_id\n2. Checks batch status via OpenAI API\n3. Routes based on status:\n   - **Completed**: Downloads results, parses JSONL, updates Shopify products\n   - **In Progress**: Does nothing (run again later)\n   - **Failed/Expired**: Error handling\n\n**Schedule:** Every 30 minutes until batch completes\n\n**Note:** Replace {{OPENAI_API_KEY}} with your actual key",
                "designer": {
                    "x": 900,
                    "y": -350
                }
            }
        ]
    }
}
